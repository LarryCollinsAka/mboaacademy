datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  TRAINER
  ADMIN
}

enum LearningMode {
  HYBRID
  ONSITE
  ONLINE
}

enum CohortStatus {
  PLANNED
  ENROLLING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  SUCCESS
  REJECTED
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  role          Role      @default(STUDENT)
  avatar        String?
  image         String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments                  Enrollment[]
  notes                        StudentNote[]
  submissions                  Submission[]
  coursesTaught                Course[]      @relation("InstructorCourses")
  cohortsTaught                Cohort[]      @relation("CohortTrainers")
  accounts                     Account[]
  sessions                     Session[]
  payments                     Payment[]
  paymentReviews               PaymentReview[] @relation("PaymentReviewReviewer")
  reviewedPayments             Payment[] @relation("PaymentReviewer")
  enrollmentExceptionsApproved Enrollment[]  @relation("EnrollmentExceptionApprover")
}

model Course {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  headline      String
  description   String
  category      String       @default("Value-Creating Skills")
  level         String       @default("All Levels") // Beginner, Intermediate, Advanced
  mode          LearningMode @default(HYBRID)
  price         Float        @default(0.0)
  currency      String       @default("XAF")
  durationHours Int          @default(40)
  durationDays  Int? // Nominal calendar duration; cohort dates remain authoritative for each run
  thumbnail     String?
  skills        String[] // Graph node references (e.g. "React", "Next.js", "Docker")
  published     Boolean      @default(false)

  instructorId String?
  instructor   User?   @relation("InstructorCourses", fields: [instructorId], references: [id])

  modules     Module[]
  enrollments Enrollment[]
  cohorts     Cohort[]
  assignments Assignment[]
  payments    Payment[]
  coursePrices CoursePrice[]
  translations CourseTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model CoursePrice {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // ISO 3166-1 alpha-2 country code, or "GLOBAL"
  marketCode String   @default("GLOBAL")
  // ISO 4217 currency code: XAF, XOF, EUR, USD, NGN, etc.
  currency   String   @db.VarChar(3)
  amount     Decimal  @db.Decimal(12, 2)

  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payments   Payment[]

  @@unique([courseId, marketCode, currency])
  @@index([marketCode, currency, isActive])
  @@index([courseId, isActive])
}


model CourseTranslation {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  locale      String
  language    Language @relation(fields: [locale], references: [code], onDelete: Cascade)
  skills String[] @default([])

  title       String
  headline    String
  description String   @db.Text
  category    String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, locale])
  @@index([locale])
}

model Cohort {
  id                  String       @id @default(cuid())
  courseId            String
  course              Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name                String
  code                String       @unique
  startsAt            DateTime
  endsAt              DateTime
  timezone            String       @default("Africa/Douala")
  mode                LearningMode
  status              CohortStatus @default(PLANNED)
  enrollmentOpensAt   DateTime?
  enrollmentClosesAt  DateTime?
  weeklyLearningHours Float?
  scheduleNotes       String?      @db.Text
  capacity            Int?
  trainers            User[]       @relation("CohortTrainers")
  enrollments         Enrollment[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([courseId, startsAt, endsAt])
  @@index([status, startsAt])
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int      @default(1)
  lessons  Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id              String  @id @default(cuid())
  moduleId        String
  module          Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  content         String? @db.Text
  videoUrl        String?
  durationMinutes Int     @default(15)
  order           Int     @default(1)
  isFreePreview   Boolean @default(false)

  notes       StudentNote[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title     String   @default("Untitled Note")
  content   String   @db.Text
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id           String       @id @default(cuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId     String?
  lesson       Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title        String
  instructions String       @db.Text
  maxPoints    Int          @default(100)
  dueDate      DateTime?
  submissions  Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentUrl   String?
  textContent  String?          @db.Text
  score        Int?
  feedback     String?          @db.Text
  status       SubmissionStatus @default(SUBMITTED)

  submittedAt DateTime  @default(now())
  gradedAt    DateTime?
}

model Enrollment {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  mode        LearningMode     @default(HYBRID)
  status      EnrollmentStatus @default(ACTIVE)
  progress    Int              @default(0)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  // Superadmin-approved exception metadata
  isException           Boolean   @default(false)
  exceptionReason       String?
  exceptionApprovedAt   DateTime?
  exceptionApprovedById String?
  exceptionApprovedBy   User?     @relation("EnrollmentExceptionApprover", fields: [exceptionApprovedById], references: [id], onDelete: Restrict)

  @@index([cohortId, status])
  @@index([userId, courseId, cohortId])
  @@index([exceptionApprovedById])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String        
  provider    String // "STRIPE", "MOMO", "ORANGE_MONEY"
  providerRef String?
  coursePriceId String?
  coursePrice   CoursePrice? @relation(fields: [coursePriceId], references: [id], onDelete: SetNull)
  status      PaymentStatus @default(PENDING)
  paymentReference String? @unique
  senderPhone String?
  evidencePath String?
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewedById String?
  reviewedBy User? @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes String? @db.Text
  reviews PaymentReview[]

  @@index([status, createdAt])
  @@index([reviewedById])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentReview {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User     @relation("PaymentReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision    String   // CONFIRMED or REJECTED
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([paymentId, createdAt])
  @@index([reviewerId, createdAt])
}

model Testimonial {
  id          String   @id @default(cuid())
  studentName String
  role        String
  company     String
  review      String   @db.Text
  rating      Int      @default(5)
  avatar      String?
  courseName  String
  isOnSite    Boolean  @default(true)
  featured    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @db.Text
  coverImage  String?
  authorName  String   @default("Mboa Academy Editorial")
  category    String   @default("Career Insights")
  tags        String[]
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
}

model Language {
  code       String   @id // e.g. "en", "fr", "es", "de"
  name       String // e.g. "English", "Français"
  nativeName String? // e.g. "Français", "Deutsch"
  flag       String? // e.g. "🇬🇧", "🇫🇷", "🇨🇲"
  courseTranslations CourseTranslation[]
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  translations Translation[]
}

model Translation {
  id        String   @id @default(cuid())
  locale    String // references Language.code
  language  Language @relation(fields: [locale], references: [code], onDelete: Cascade)
  namespace String   @default("common") // e.g. "common", "nav", "hero", "courses", "lms"
  key       String // e.g. "hero_title", "apply_now"
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
  @@index([locale, namespace])
}

// Auth.js / NextAuth adapter models. Authentication providers and session handling
// must still be configured in application code before protected routes are enabled.
model Account {
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
